# Absolute path to the ComfyUI installation used for standalone development.
COMFYUI_PATH=C:/path/to/ComfyUI

# Absolute path to the ComfyUI output folder that Image Shelf should index.
# Optional: defaults to <COMFYUI_PATH>/output
COMFYUI_OUTPUT_FOLDER=C:/path/to/ComfyUI/output

# Absolute path to the ComfyUI user settings file.
# Optional: defaults to <COMFYUI_PATH>/user/default/comfy.settings.json
COMFYUI_SETTINGS_PATH=C:/path/to/ComfyUI/user/default/comfy.settings.json

# The port that the backend server will listen on when running in standalone mode.
BACKEND_STANDALONE_PORT=5678
