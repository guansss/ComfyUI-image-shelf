    "cn": "^0.3.2",
    "exifr": "^7.1.3",
    "jotai": "^2.20.3",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.39.0",
    "mitt": "^3.0.1",
    "oxlint": "^1.81.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-use": "^17.6.1",
    "shadcn": "^4.20.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
