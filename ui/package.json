    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "globals": "^17.12.0",
    "identity-obj-proxy": "^3.0.0",
    "oxfmt": "^0.66.0",
    "pinia": "^4.0.3",
    "type-fest": "^5.9.0",
    "typescript": "^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
