{
  "name": "comfyui-example-react-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fix-comfy-types.js",
    "dev": "cross-env USE_STANDALONE_BACKEND=true vite",
    "build": "vite build",
    "watch": "vite build --watch",
