        "cn": "查找带有正面标签 \"cat\" 的图像"
      },
      "tag:cat": {
        "en": "Find images with positive tag \"cat\"",
        "cn": "查找带有正面标签 \"cat\" 的图像"
      },
      "tag:-cat": {
        "en": "Find images with negative tag \"cat\"",
        "cn": "查找带有负面标签 \"cat\" 的图像"
